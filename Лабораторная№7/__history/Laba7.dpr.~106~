program Laba7;

{$APPTYPE CONSOLE}
{$R *.res}

uses
  System.SysUtils;

const
  sogls = 'BCDFGHJKLMNPQRSTVWXYZ';

function SplitStringToWords(const Input: string): TArray<string>;
var
  I, WordStart: Integer;
  TempWord: string;
begin
  SetLength(Result, 0);
  WordStart := 0;
  for I := 1 to Length(Input) do
  begin
    if (Input[I] = ' ') and (WordStart > 0) then
    begin
      TempWord := Copy(Input, WordStart, I - WordStart);
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := TempWord;
      WordStart := 0;
    end

    else if (Input[I] <> ' ') and (WordStart = 0) then
    begin
      WordStart := I;
    end;
  end;

  if WordStart > 0 then
  begin
    TempWord := Copy(Input, WordStart, Length(Input) - WordStart + 1);
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)] := TempWord;
  end;
end;

function CalculateSogls(const Input: string): real;
begin
  var
    count: Integer;
    count:=0;
  for var I := Low(Input) to High(Input) do
  begin
    if sogls.Contains(UpperCase(Input[I])) then
      Inc(count);
  end;

  Result := count / Length(Input);
end;

procedure DualInsertionSort(var Arr: array of real; var Arr2: array of String);
var
  I, J: Integer;
  Current: real;
  currentS: string;
begin
  for I := 1 to High(Arr) do
  begin
    Current := Arr[I];
    currentS := Arr2[I];
    J := I - 1;

    while (J >= 0) and (Arr[J] > Current) do
    begin
      Arr[J + 1] := Arr[J];
      Arr2[J + 1] := Arr2[J];

      Dec(J);
    end;

    Arr[J + 1] := Current;
    Arr2[J + 1] := currentS;
  end;
end;

begin
  var
    str, s1, s2, usedCombos,last: string;
  var
    words: TArray<string>;
  Readln(str);
  words := SplitStringToWords(str);
  for var I := Low(words) to High(words) - 1 do
  begin

    if LowerCase(words[I]) <> LowerCase(words[High(words)]) then
      s1 := s1 + words[I] + ' ';
  end;
  if Length(words) <> 0 then
    s1 := s1 + words[High(words)];
  for var I := Low(str) to High(str) - 1 do
  begin
    var
      Combo: string;
    var
      Counter: Integer;
    Counter := 1;
    Combo := LowerCase(str[I] + str[I + 1]);
    if not(usedCombos.Contains(Combo) or Combo.Contains(' ')) then
    begin
      usedCombos := usedCombos + Combo;
      for var J := I + 1 to High(str) - 1 do
      begin
        if LowerCase(str[J] + str[J + 1]) = Combo then
          Inc(Counter);

      end;
      s1 := s1 + ' ' + Combo + '-' + IntToStr(Counter);
    end;

  end;

  If s1 = '' then
    Writeln('S1 is: Empty string')
  else
    Writeln('S1 is: ''', s1, '''');

  var
    parts: TArray<real>;
  last:=words[High(words)];
  SetLength(parts, Length(words));
  for var I := Low(parts) to High(parts) do
  begin
    parts[I] := CalculateSogls(words[I]);
  end;
  DualInsertionSort(parts, words);

  for var I := Low(words) to High(words) - 1 do
  begin

    if LowerCase(words[I]) <> LowerCase(last) then
      s2 := s2 + words[I] + ' ';
  end;
  if (Length(words) <> 0) and (LowerCase(words[High(words)]) <> LowerCase(last)) then
    s2 := s2 + words[High(words)];

  If s2 = '' then
    Writeln('S2 is: Empty string')
  else
    Writeln('S2 is: ''', s2, '''');
  Readln;
end.
