end;

procedure printInfo(var A, b: arrT; curLen: integer; name: string);
begin
  var
    comparisonCounter, swapCounter: integer;
  b := A;
  comparisonCounter := 0;
  swapCounter := 0;
  simpleBuble_Sort(b, curLen, comparisonCounter, swapCounter);
  write('|N=', curLen:4, ' ', name, '|');
  write(swapCounter:10, '|', comparisonCounter:10, '|');
  b := A;
  comparisonCounter := 0;
  swapCounter := 0;
  shake_sort(b, curLen, comparisonCounter, swapCounter);
  write(swapCounter:10, '|', comparisonCounter:10, '|');
  writeln('          |          |');

  A := b;
  writeln('|-------------|----------|----------|----------|----------|----------|----------|');

end;

