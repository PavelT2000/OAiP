const
  L = 2000;
  RandomLength = 100;

var
  curLen: integer;

Type
  arrT = array [1 .. L] of integer;

procedure generateUnSortedMas(var arr: arrT);
begin
  for var I := 1 to L do
  begin
    arr[I] := Random(RandomLength);
  end;
end;

procedure changeSortedMas(var arr: arrT; N: integer);
begin
  for var I := 1 to trunc(N / 10) do
  begin
    arr[Random(9) + (I - 1) * 10 + 1] := Random(RandomLength);

  end;
end;

procedure invertSortedMas(var arr: arrT; N: integer);
begin
  var
    buf: integer;
  for var I := 1 to trunc(N / 2) do
  begin
    buf := arr[I];
    arr[I] := arr[N - I + 1];
    arr[N - I + 1] := buf;
  end;

end;

procedure shake_sort(var arr: arrT; N: integer;
  var comparisonCounter, swapCounter: integer);

var
  left, right, I, temp, lastSwap: integer;
begin
  left := 1;
  right := N;
  lastSwap := 0;
  while (right > left) do
  begin
    for I := left to right - 1 do
    begin
      comparisonCounter := comparisonCounter + 1;
      if (arr[I] > arr[I + 1]) then
      begin
        swapCounter := swapCounter +1;
        temp := arr[I];
        arr[I] := arr[I + 1];
        arr[I + 1] := temp;
        lastSwap := I;
      end;
    end;
    right := lastSwap;

    for I := right downto left + 1 do
    begin
      comparisonCounter := comparisonCounter + 1;
      if (arr[I] < arr[I - 1]) then
      begin
        swapCounter := swapCounter + 1;
        temp := arr[I];
        arr[I] := arr[I - 1];
        arr[I - 1] := temp;
        lastSwap := I;
      end;
    end;
    left := lastSwap;

  end;
end;

procedure simpleBuble_Sort(var A: arrT; N: integer;
  var comparisonCounter, swapCounter: integer);
begin
  var
    I, temp, j: integer;
  I := 2;
  while I <= N do
  begin
    j := N;
    while j >= I do
    begin
      comparisonCounter := comparisonCounter + 1;
      if A[j - 1] > A[j] then
      begin
        swapCounter := swapCounter + 1;
        temp := A[j - 1];
        A[j - 1] := A[j];
        A[j] := temp;
      end;
      j := j - 1;
    end;
    I := I + 1;
  end;

end;

