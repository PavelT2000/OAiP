program Laba7;

{$APPTYPE CONSOLE}
{$R *.res}

uses
  System.SysUtils, System.StrUtils;

begin
  var
    str, s1, s2, usedCombos, lastWord: string;
  readln(str);

  begin
    var
    i := length(str);

    while (str[i] <> ' ') and (i <> 1) do
      Dec(i);
    lastWord := str.Substring(i - 1, length(str));
  end;

  s1 := StringReplace(str, lastWord + ' ', '', [rfReplaceAll]);

  for var i := 1 to length(str) - 1 do
  begin
    var
      doubleLetter: string;
    var
      counter: integer;
    counter := 1;
    doubleLetter := str[i] + str[i + 1];
    if not doubleLetter.Contains(' ') then
    begin

      for var j := i + 1 to length(str) - 1 do
      begin
        if (str[j] + str[j + 1]) = doubleLetter then
          Inc(counter);
      end;
      usedCombos := usedCombos + doubleLetter + ' ';
      s1 := s1 + ' ' + doubleLetter + '-' + IntToStr(counter);
    end;
  end;

  writeln(s1);
  readln;

end.
