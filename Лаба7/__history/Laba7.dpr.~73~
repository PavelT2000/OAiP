program Laba7;

{$APPTYPE CONSOLE}
{$R *.res}

uses
  System.SysUtils;

function SplitStringToWords(const Input: string): TArray<string>;
var
  I, WordStart: Integer;
  TempWord: string;
begin
  SetLength(Result, 0);
  WordStart := 0;
  for I := 1 to Length(Input) do
  begin
    if (Input[I] = ' ') and (WordStart > 0) then
    begin
      TempWord := Copy(Input, WordStart, I - WordStart);
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := TempWord;
      WordStart := 0;
    end

    else if (Input[I] <> ' ') and (WordStart = 0) then
    begin
      WordStart := I;
    end;
  end;

  if WordStart > 0 then
  begin
    TempWord := Copy(Input, WordStart, Length(Input) - WordStart + 1);
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)] := TempWord;
  end;
end;

begin
  var
    str, s1, s2, usedCombos: string;
  var
    words: TArray<string>;
  Readln(str);
  words := SplitStringToWords(str);
  for var I := Low(words) to High(words) - 1 do
  begin

    if LowerCase(words[I]) <> LowerCase(words[High(words)]) then
      s1 := s1 + words[I] + ' ';
  end;
  if Length(words) <> 0 then
    s1 := s1 + words[High(words)];
  for var I := Low(Str) to High(Str) - 1 do
  begin
    var
      Combo: string;
    var
      Counter: Integer;
    Counter := 1;
    Combo := LowerCase(Str[I] + Str[I + 1]);
    if not (usedCombos.Contains(Combo) or Str.Contains(' ')) then
    begin
      usedCombos := usedCombos + Combo;
      for var j := I + 1 to High(Str) - 1 do
      begin
        if LowerCase(Str[j] + Str[j + 1]) = Combo then
          Inc(Counter);

      end;
      s1 := s1 + ' ' + Combo + '-' + IntToStr(Counter);
    end;

  end;

  If s1 = '' then
    Writeln('S1 is: Empty string')
  else
    Writeln('S1 is: ''', s1, '''');
  Readln;

end.
