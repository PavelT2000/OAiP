function SplitStringToWords(const Input: string): TArray<string>;
var
  I, WordStart: Integer;
  TempWord: string;
begin
  SetLength(Result, 0);
  WordStart := 0;
  for I := 1 to Length(Input) do
  begin
    if (Input[I] = ' ') and (WordStart > 0) then
    begin
      TempWord := Copy(Input, WordStart, I - WordStart);
      SetLength(Result, Length(Result) + 1);
      Result[High(Result)] := TempWord;
      WordStart := 0;
    end

    else if (Input[I] <> ' ') and (WordStart = 0) then
    begin
      WordStart := I;
    end;
  end;

  if WordStart > 0 then
  begin
    TempWord := Copy(Input, WordStart, Length(Input) - WordStart + 1);
    SetLength(Result, Length(Result) + 1);
    Result[High(Result)] := TempWord;
  end;
end;

