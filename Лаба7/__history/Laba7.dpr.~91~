procedure DualInsertionSort(var Arr: array of Real;var Arr2: array of String);
var
  I, J: Integer;
  Current: Real;
  currentS:string;
begin
  for I := 1 to High(Arr) do
  begin
    Current := Arr[I];
    J := I - 1;

    while (J >= 0) and (Arr[J] > Current) do
    begin
      Arr[J + 1] := Arr[J];
      Dec(J);
    end;

    // Вставляем элемент на своё место
    Arr[J + 1] := Current;
  end;
end;
