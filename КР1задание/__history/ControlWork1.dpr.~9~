program ControlWork1;

uses
  System.SysUtils;

begin
  var
    a, b, h, x, y, eps: real;
  Write('Введите A:');
  Readln(a);
  Write('Введите B:');
  Readln(b);
  Write('Введите шаг H:');
  Readln(h);
  Writeln('|------------|------------|');
  Writeln('|     X      |      Y     |');
  Writeln('|------------|------------|');
  eps := abs(h / 1000000);
  x := a;
  if abs(x - 5) < eps then
  begin
    Writeln('|', x:12:6, '|Нет значения|');
    Writeln('|------------|------------|');
  end
  else
  begin
    y :=(cos(Pi*x)*(abs(x/3-1/3) / (x/3-1/3))
        * exp(ln(abs(x/3-1/3))/7))/(x-5);
    if(x=1) then
      y:=0;
    Writeln('|', x:12:6, '|', y:12:6, '|');
    Writeln('|------------|------------|');
  end;
  while ((x > b) and (h < 0) and (x + h > b)) or
    ((x < b) and (h > 0) and (x + h < b)) do
  begin
    x := x + h;
    if abs(x - 5) < eps then
    begin
      Writeln('|', x:12:6, '|Нет значения|');
      Writeln('|------------|------------|');
    end
    else
    begin

     y :=(cos(Pi*x)*(abs(x/3-1/3) / (x/3-1/3))
        * exp(ln(abs(x/3-1/3))/7))/(x-5);
      if(x=1) then
      y:=0;
      Writeln('|', x:12:6, '|', y:12:6, '|');
      Writeln('|------------|------------|');
    end;
  end;
  if (abs(x - b) > eps) then
  begin
    x := b;
    if abs(x - 5) < eps then
    begin
      Writeln('|', x:12:6, '|Нет значения|');
      Writeln('|------------|------------|');
    end
    else
    begin
      y :=(cos(Pi*x)*(abs(x/3-1/3) / (x/3-1/3))
        * exp(ln(abs(x/3-1/3))/7))/(x-5);
      if(x=1) then
      y:=0;
      Writeln('|', x:12:6, '|', y:12:6, '|');
      Writeln('|------------|------------|');
    end;
  end;
  Readln;

end.
