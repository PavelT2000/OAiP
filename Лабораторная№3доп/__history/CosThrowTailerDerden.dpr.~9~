program SinThrowTailerDerden;
{$APPTYPE CONSOLE}
{$R *.res}

uses
  System.SysUtils;

begin
  var
    sin, ans, next, eps: real;
  var
    fact, i, k: integer;

  eps := 0.0001;
  k := 0;

  if sin>=2*Pi then
  begin
    sin:=sin-((trunc(sin/Pi) div 2)*2)*Pi;
  end;
  // Расчёт члена суммы
  // Расчёт факториала
  fact := 1;
  for i := 1 to 2 * k + 1 do
  begin
    fact := fact * i;
  end;
  //
  // Расчёт степени
  next := input;
  for i := 2 to 2 * k + 1 do
  begin
    next := next * input;
  end;
  //
  ans := next / fact;
  k := k + 1;

  // Расчёт члена суммы
  // Расчёт факториала
  fact := 1;
  for i := 1 to 2 * k + 1 do
  begin
    fact := fact * i;
  end;
  //
  // Расчёт степени
  next := input;
  for i := 2 to 2 * k + 1 do
  begin
    next := next * input;
  end;
  next := next / fact;
  //

  while abs(next) >= eps do
  begin
    if (k mod 2) = 1 then
      ans := ans - next
    else
      ans := ans + next;
    k := k + 1;
    // Расчёт члена суммы
      // Расчёт факториала
    fact := 1;
    for i := 1 to 2 * k + 1 do
    begin
      fact := fact * i;
    end;
    //
      // Расчёт степени
    next := input;
    for i := 2 to 2 * k + 1 do
    begin
      next := next * input;
    end;
    next := next / fact;
  end;

  writeln(ans:16:8, ' ', sin(input):16:8);
  readln(input);

end.
